# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# openFDA API key — optional but recommended.
# Without key : 40 requests/min, 1 000 requests/day
# With key    : 240 requests/min, 120 000 requests/day
# Get yours at: https://open.fda.gov/apis/authentication/
FDA_API_KEY=your_openfda_api_key_here

# Required for LLM-driven CrewAI agents (optional — pipeline runs without it)
#OPENAI_API_KEY=sk-...

# Optional: override default model
#OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: use Anthropic instead of OpenAI
#ANTHROPIC_API_KEY=sk-...